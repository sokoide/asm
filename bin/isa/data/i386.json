      "addressing": ["レジスタ", "即値", "間接(base+index×scale+disp)"],
      "flags": ["‡", "-", "-", "‡", "‡", "‡", "‡", "‡"],
      "cycles": [{"cond": "reg-reg / 即値→reg", "cycles": 2}, {"cond": "mem を含む", "cycles": "6〜7"}],
      "encodings": [{"syntax": "ADC r/m, r", "opcode": "11 /r（8bit は 10 /r）", "bytes": 2}, {"syntax": "ADC r/m, imm", "opcode": "81 /2 iv", "bytes": 4}],
      "notes": "",
      "src": "book"
    },
    {
      "mnemonic": "SUB",
      "operands": "dst, src",
      "category": "算術",
      "summary": "dst から src を減算する。桁借りは C、符号付きオーバーフローは O で検出。",
      "addressing": ["レジスタ", "即値", "間接(base+index×scale+disp)"],
      "flags": ["‡", "-", "-", "‡", "‡", "‡", "‡", "‡"],
