      "src": "book"
    },
    {
      "mnemonic": "ADDX",
      "operands": "src, dst",
      "category": "算術",
      "summary": "X 込み加算（多倍長演算用）。Z は結果が非 0 のときだけ 0 にクリア（1 には立たない）。",
