      "flags": ["‡", "‡", "‡", "‡", "‡"],
      "cycles": [{"cond": "ADDQ.W #1,D0", "cycles": 4}, {"cond": "ADDQ.L #1,A0（フラグ不変）", "cycles": 8}],
