{
  "arch": "arm64",
  "flagNames": ["N", "Z", "C", "V"],
  "instructions": [
    {
      "mnemonic": "MOV",
      "operands": "dst, src",
      "category": "データ転送",
      "summary": "汎用データ転送（アセンブラ疑似命令。実体は ORR #0 または MOVZ/MOVN/MOVK）。フラグは変化しない。",
      "addressing": ["レジスタ", "即値（16ビットシフト付き）"],
      "flags": ["-", "-", "-", "-"],
      "cycles": [{"cond": "実装依存", "cycles": 1}],
      "encodings": [{"syntax": "MOV Wd, #imm / MOV Xd, Xn", "opcode": "ORR / MOVZ に展開"}],
      "notes": "64 ビット即値は MOVZ/MOVK を 2〜4 回組合せる。MOV Wn,#imm は 0〜65535 の即値に制限される。",
      "src": "knowledge"
    },
    {
      "mnemonic": "MOVZ",
      "operands": "dst, #imm16{, LSL #shift}",
      "category": "データ転送",
      "summary": "16 ビット即値を指定シフト位置に配置し、残りを 0 でクリアする。",
      "addressing": ["即値"],
      "flags": ["-", "-", "-", "-"],
      "cycles": [{"cond": "実装依存", "cycles": 1}],
      "encodings": [{"syntax": "MOVZ Xd,#imm16,LSL #shift", "opcode": "1 11 100101 hw imm16 Rd"}],
      "notes": "shift は 0/16/32/48。64 ビット即値の組み立てに使う。",
      "src": "knowledge"
    },
    {
      "mnemonic": "MOVN",
      "operands": "dst, #imm16{, LSL #shift}",
      "category": "データ転送",
      "summary": "16 ビット即値を反転（NOT）して配置し、残りを 1 で満たす。-1 に近い即値の生成用。",
      "addressing": ["即値"],
      "flags": ["-", "-", "-", "-"],
      "cycles": [{"cond": "実装依存", "cycles": 1}],
      "encodings": [{"syntax": "MOVN Xd,#imm16,LSL #shift", "opcode": "1 00 100101 hw imm16 Rd"}],
      "notes": "",
      "src": "knowledge"
    },
    {
      "mnemonic": "MOVK",
      "operands": "dst, #imm16{, LSL #shift}",
      "category": "データ転送",
      "summary": "16 ビット即値を指定シフト位置に上書き（他のビットは保持）。64 ビット即値の組み立て用。",
      "addressing": ["即値"],
      "flags": ["-", "-", "-", "-"],
      "cycles": [{"cond": "実装依存", "cycles": 1}],
      "encodings": [{"syntax": "MOVK Xd,#imm16,LSL #shift", "opcode": "1 11 100101 hw imm16 Rd"}],
      "notes": "MOVZ と MOVK の組合せが 64 ビット即値ロードの定番（adr/litpool に次ぐ方法）。",
      "src": "knowledge"
    },
    {
