{
  "arch": "m68k",
  "flagNames": ["N", "Z", "V", "C", "X"],
  "instructions": [
    {
      "mnemonic": "MOVE",
      "operands": "src, dst",
      "category": "データ転送",
      "summary": "8/16/32 ビット（.B/.W/.L）の汎用データ転送。src → dst。",
      "addressing": ["全 EA（dst はデータ可変）"],
      "flags": ["‡", "‡", "0", "0", "-"],
      "cycles": [{"cond": "MOVE.L D0,D1（レジスタ間）", "cycles": 4}, {"cond": "MOVE.W #n,D0", "cycles": 8}, {"cond": "MOVE.W (A0),D0", "cycles": 8}, {"cond": "MOVE.L (A0),D0", "cycles": 12}],
      "encodings": [{"syntax": "MOVE.B/W/L src,dst", "opcode": "00 SS RRRMMM ...", "bytes": 2}]
    },
    {
      "mnemonic": "MOVEA",
      "operands": "src, An",
      "category": "データ転送",
      "summary": "アドレスレジスタへの転送。.W は符号拡張して 32 ビットに。フラグは一切変化しない。",
      "addressing": ["全 EA（src）"],
      "flags": ["-", "-", "-", "-", "-"],
      "cycles": [{"cond": "MOVEA.W (A0),A1", "cycles": 8}, {"cond": "MOVEA.L #n,A0", "cycles": 12}]
    },
    {
      "mnemonic": "MOVEQ",
      "operands": "#d, Dn",
      "category": "データ転送",
      "summary": "8 ビット符号拡張即値をデータレジスタへ高速転送（A = -1 で 32 ビット -1 が入る）。フラグ更新あり。",
      "addressing": ["即値 → Dn（.L のみ）"],
      "flags": ["‡", "‡", "0", "0", "-"],
      "cycles": [{"cond": "常時", "cycles": 4}],
      "encodings": [{"syntax": "MOVEQ #d,Dn", "opcode": "0 111 DDD 0 dddddddd", "bytes": 2}],
      "notes": "MOVE.L #imm,D0 より 2 クロック速い。-128〜127 のみ。フラグを変えるのが MOVE.L #imm との違い。",
      "src": "book"
    },
    {
      "mnemonic": "MOVEM",
      "operands": "list, dst / src, list",
      "category": "データ転送",
      "summary": "複数レジスタの一括退避/復帰（.W/.L）。レジスタリストは D0-D7/A0-A7 の指定。",
      "addressing": ["レジスタリスト", "(An)+", "-(An)", "絶対", "相対"],
      "flags": ["-", "-", "-", "-", "-"],
      "cycles": [{"cond": "MOVEM.L D0-D2/A4-A6,-(A7)", "cycles": "8+8n（目安）"}],
      "encodings": [{"syntax": "MOVEM.L list,-(A7)", "opcode": "0100100 1 x ...", "bytes": 4}]
    },
    {
      "mnemonic": "MOVEP",
      "operands": "Dn, (d,An)",
      "category": "データ転送",
      "summary": "データレジスタとメモリ間のニブル単位転送（周辺 I/O 用）。上位バイトから順に 2 バイト/4 バイト書く。",
      "addressing": ["ディスプレースメント間接"],
      "flags": ["-", "-", "-", "-", "-"],
      "cycles": [{"cond": "MOVEP.W", "cycles": 16}, {"cond": "MOVEP.L", "cycles": 24}]
    },
    {
      "mnemonic": "LEA",
      "operands": "ea, An",
