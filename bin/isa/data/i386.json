{
  "arch": "i386",
  "flagNames": ["O", "D", "I", "S", "Z", "A", "P", "C"],
  "instructions": [
    {
      "mnemonic": "MOV",
      "operands": "dst, src",
      "category": "データ転送",
      "summary": "転送。src（レジスタ・メモリ・即値・セグメントレジスタ）の値を dst にコピーする。",
      "addressing": ["レジスタ", "即値", "間接(base+index×scale+disp)", "直接(seg:offset による far)"],
      "flags": ["-", "-", "-", "-", "-", "-", "-", "-"],
      "cycles": [{"cond": "reg-reg", "cycles": 2}, {"cond": "reg,mem", "cycles": 4}, {"cond": "mem-reg / 即値", "cycles": 2}],
      "encodings": [{"syntax": "MOV r/m, r", "opcode": "89 /r（8bit は 88 /r）", "bytes": 2}, {"syntax": "MOV r, r/m", "opcode": "8B /r（8bit は 8A /r）", "bytes": 2}, {"syntax": "MOV r, imm", "opcode": "B8+r iv（8bit は B0+r ib）", "bytes": 2}, {"syntax": "MOV r/m16, Sreg", "opcode": "8C /r", "bytes": 2}, {"syntax": "MOV Sreg, r/m16", "opcode": "8E /r", "bytes": 2}],
      "notes": "mem→mem は直接転送できない。\nセグメントレジスタ転送（8C/8E）はプロテクトモードでは 16bit 選択子（TI ビットで GDT/LDT、下位 2bit は RPL）を扱い、CS への書き込みは不可。FS/GS は 80386 で追加。\nCR0/DR0 等のシステムレジスタへの転送は 0F 20〜23 の専用形（特権）。",
      "src": "book"
    },
    {
      "mnemonic": "MOVZX",
      "operands": "dst, src",
      "category": "データ転送",
      "summary": "ゼロ拡張転送。8/16ビットの src を上位ビット 0 埋めで 16/32ビットの dst に転送する（80386 で導入）。",
      "addressing": ["レジスタ", "間接(base+index×scale+disp)"],
      "flags": ["-", "-", "-", "-", "-", "-", "-", "-"],
      "cycles": [{"cond": "reg-reg", "cycles": 3}, {"cond": "reg-mem", "cycles": 6}],
      "encodings": [{"syntax": "MOVZX r16/32, r/m8", "opcode": "0F B6 /r", "bytes": 3}, {"syntax": "MOVZX r32, r/m16", "opcode": "0F B7 /r", "bytes": 3}],
      "notes": "80386 で導入。imm は取れない。",
      "src": "book"
    },
    {
      "mnemonic": "MOVSX",
      "operands": "dst, src",
      "category": "データ転送",
      "summary": "符号拡張転送。8/16ビットの src を符号拡張して 16/32ビットの dst に転送する（80386 で導入）。",
      "addressing": ["レジスタ", "間接(base+index×scale+disp)"],
      "flags": ["-", "-", "-", "-", "-", "-", "-", "-"],
      "cycles": [{"cond": "reg-reg", "cycles": 3}, {"cond": "reg-mem", "cycles": 6}],
      "encodings": [{"syntax": "MOVSX r16/32, r/m8", "opcode": "0F BE /r", "bytes": 3}, {"syntax": "MOVSX r32, r/m16", "opcode": "0F BF /r", "bytes": 3}],
      "notes": "80386 で導入。",
      "src": "book"
    },
    {
      "mnemonic": "XCHG",
      "operands": "dst, src",
      "category": "データ転送",
      "summary": "2つのオペランドの内容を交換する。レジスタ同士またはレジスタとメモリ。",
      "addressing": ["レジスタ", "間接(base+index×scale+disp)"],
      "flags": ["-", "-", "-", "-", "-", "-", "-", "-"],
      "cycles": [{"cond": "reg-reg", "cycles": 3}, {"cond": "mem を含む", "cycles": 5}],
      "encodings": [{"syntax": "XCHG AX, r16", "opcode": "90+r", "bytes": 1}, {"syntax": "XCHG r/m, r", "opcode": "87 /r（8bit は 86 /r）", "bytes": 2}],
      "notes": "XCHG AX, AX（90）は NOP。\nメモリを含む場合は暗黙に LOCK されアトミックに実行される。",
      "src": "book"
    },
    {
      "mnemonic": "LEA",
      "operands": "reg, mem",
      "category": "データ転送",
      "summary": "メモリ参照式の実効アドレスを計算してレジスタに入れる。メモリアクセスは行わない。",
      "addressing": ["間接(base+index×scale+disp)"],
      "flags": ["-", "-", "-", "-", "-", "-", "-", "-"],
      "cycles": [{"cond": "常時", "cycles": 2}],
      "encodings": [{"syntax": "LEA r16/32, m", "opcode": "8D /r", "bytes": 2}],
      "notes": "[base + index×scale + disp]（scale=1/2/4/8）の計算を 1 命令で行えるためアドレス演算の定石。フラグ不変。",
      "src": "book"
    },
    {
      "mnemonic": "CBW",
      "operands": "",
      "category": "データ転送",
      "summary": "AL の符号拡張（8→16bit）で AX に転送する。",
      "addressing": ["暗黙"],
      "flags": ["-", "-", "-", "-", "-", "-", "-", "-"],
      "cycles": [{"cond": "常時", "cycles": 3}],
      "encodings": [{"syntax": "CBW", "opcode": "66 98（32bit モード）", "bytes": 2}],
      "notes": "32bit プロテクトモードでは既定オペランド 32bit のため CBW に 66 プレフィックス。16bit モードでは CBW=98 / CWDE=66 98。",
      "src": "book"
    },
    {
      "mnemonic": "CWDE",
      "operands": "",
      "category": "データ転送",
      "summary": "AX の符号拡張（16→32bit）で EAX に転送する（80386 で導入）。",
      "addressing": ["暗黙"],
      "flags": ["-", "-", "-", "-", "-", "-", "-", "-"],
      "cycles": [{"cond": "常時", "cycles": 3}],
      "encodings": [{"syntax": "CWDE", "opcode": "98（32bit モード）", "bytes": 1}],
      "notes": "IDIV（32bit）の前処理には CDQ（99）で EDX:EAX を作る。",
      "src": "book"
    },
    {
      "mnemonic": "PUSH",
      "operands": "src",
      "category": "スタック",
      "summary": "ESP を 4 減算してからオペランド（レジスタ・メモリ・即値・セグメントレジスタ）をスタックに格納する。",
      "addressing": ["レジスタ", "即値", "間接(base+index×scale+disp)"],
      "flags": ["-", "-", "-", "-", "-", "-", "-", "-"],
      "cycles": [{"cond": "reg / 即値", "cycles": 4}, {"cond": "mem", "cycles": 5}],
      "encodings": [{"syntax": "PUSH r16/32", "opcode": "50+r", "bytes": 1}, {"syntax": "PUSH imm32 / imm16", "opcode": "68 iv", "bytes": 3}, {"syntax": "PUSH imm8", "opcode": "6A ib", "bytes": 2}, {"syntax": "PUSH Sreg", "opcode": "06/0E/16/1E（FS: 0F A0、GS: 0F A8）", "bytes": 1}],
      "notes": "286 以降は即値 PUSH 可能。8086 とは異なり PUSH SP は命令実行前の SP 値を積む。\nオペランドサイズ（16/32bit）は既定に従い 66 プレフィックスで切替。",
      "src": "book"
    },
    {
      "mnemonic": "POP",
      "operands": "dst",
      "category": "スタック",
      "summary": "スタック先頭の値を dst に読み込み ESP を 4 加算する。",
      "addressing": ["レジスタ", "間接(base+index×scale+disp)"],
      "flags": ["-", "-", "-", "-", "-", "-", "-", "-"],
      "cycles": [{"cond": "reg", "cycles": 4}, {"cond": "mem", "cycles": 5}],
      "encodings": [{"syntax": "POP r16/32", "opcode": "58+r", "bytes": 1}, {"syntax": "POP Sreg", "opcode": "07/17/1F（FS: 0F A1、GS: 0F A9）", "bytes": 1}],
      "notes": "POP CS は存在しない（far RET か IRET で CS を復帰）。POP SS 後は割り込みが 1 命令抑止される。",
      "src": "book"
    },
    {
      "mnemonic": "PUSHA",
      "operands": "",
      "category": "スタック",
      "summary": "AX/CX/DX/BX/命令前の SP/BP/SI/DI の順に 8 個の 16bit レジスタを一括退避する（80286 で導入）。",
      "addressing": ["スタック"],
      "flags": ["-", "-", "-", "-", "-", "-", "-", "-"],
      "cycles": [{"cond": "常時", "cycles": 18}],
      "encodings": [{"syntax": "PUSHAD（32bit モード既定）", "opcode": "60", "bytes": 1}, {"syntax": "PUSHA（66 プレフィックス）", "opcode": "66 60", "bytes": 2}],
      "notes": "32bit モードでは EAX/ECX/EDX/EBX/ESP/EBP/ESI/EDI を積む（PUSHAD、80386 から）。8086 にない命令で、80286 から導入。\\n",
      "src": "book"
    },
    {
      "mnemonic": "POPA",
      "operands": "",
      "category": "スタック",
      "summary": "スタックから 16 バイトを取り除き、DI/SI/BP/SP 位置/BX/DX/CX/AX の順（PUSHA と逆順）に 8 個の 16bit レジスタを一括復帰する（80286 で導入）。",
      "addressing": ["スタック"],
      "flags": ["-", "-", "-", "-", "-", "-", "-", "-"],
      "cycles": [{"cond": "常時", "cycles": 24}],
      "encodings": [{"syntax": "POPAD（32bit モード既定）", "opcode": "61", "bytes": 1}, {"syntax": "POPA（66 プレフィックス）", "opcode": "66 61", "bytes": 2}],
      "notes": "スタック上の SP 値は読み捨てる（復帰後に使用しない）。\\n",
      "src": "book"
    },
    {
      "mnemonic": "PUSHFD",
      "operands": "",
      "category": "スタック",
