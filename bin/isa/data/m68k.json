      "flags": ["‡", "‡", "‡", "‡", "‡"],
      "cycles": [{"cond": "ADDA.L D0,A0", "cycles": 8}]
    },
    {
      "mnemonic": "ADDI",
      "operands": "#d, dst",
      "category": "算術",
      "summary": "即値加算（.B/.W/.L）。",
