      "encodings": [{"syntax": "MUL r/m8", "opcode": "F6 /4", "bytes": 2}, {"syntax": "MUL r/m16/32", "opcode": "F7 /4", "bytes": 2}],
      "notes": "上位半分が 0 なら C=O=0、0 でなければ C=O=1。8bit は AX=AL×src、16bit は DX:AX。",
      "src": "book"
    },
    {
      "mnemonic": "IMUL",
      "operands": "src / dst, src / dst, src, imm",
      "category": "算術",
      "summary": "符号付き乗算。1オペランド形は EDX:EAX = EAX × src。2/3オペランド形（80386 で追加）は下位半分のみ dst に格納。",
      "addressing": ["レジスタ", "即値", "間接(base+index×scale+disp)"],
      "flags": ["‡", "-", "-", "U", "U", "U", "U", "‡"],
      "cycles": [{"cond": "1 オペランド形", "cycles": "9〜40"}, {"cond": "2/3 オペランド形", "cycles": "9〜38"}],
      "encodings": [{"syntax": "IMUL r/m8（1オペランド）", "opcode": "F6 /5", "bytes": 2}, {"syntax": "IMUL r/m16/32（1オペランド）", "opcode": "F7 /5", "bytes": 2}, {"syntax": "IMUL r16/32, r/m16/32", "opcode": "0F AF /r", "bytes": 3}, {"syntax": "IMUL r, r/m, imm8", "opcode": "6B /r ib", "bytes": 3}, {"syntax": "IMUL r, r/m, imm16/32", "opcode": "69 /r iv", "bytes": 4}],
      "notes": "2/3オペランド形は上位半分を切り捨てる。切り捨てで符号拡張と一致しなければ C=O=1 で検出。",
      "src": "book"
    },
    {
      "mnemonic": "DIV",
      "operands": "src",
      "category": "算術",
      "summary": "符号なし除算。EDX:EAX ÷ src で EAX=商、EDX=剰余（32bit）。",
