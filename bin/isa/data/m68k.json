      "cycles": [{"cond": "ADD.W D0,D1", "cycles": 4}, {"cond": "ADD.L D0,D1", "cycles": 8}, {"cond": "ADD.W (A0),D0", "cycles": 8}, {"cond": "ADD.W D0,(A0)", "cycles": 12}]
