      "summary": "ビット反転転送（dst = NOT src）。実体は ORN #0。",
      "addressing": ["レジスタ"],
      "flags": ["-", "-", "-", "-"],
      "cycles": [{"cond": "実装依存", "cycles": 1}],
      "encodings": [{"syntax": "MVN Wd,Wn", "opcode": "ORN Wd,WZR,Wn"}],
      "notes": "",
      "src": "knowledge"
    },
    {
