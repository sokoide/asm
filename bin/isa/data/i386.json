      "addressing": ["スタック"],
      "flags": ["‡", "‡", "‡", "‡", "‡", "‡", "‡", "‡"],
      "cycles": [{"cond": "常時", "cycles": 5}],
      "encodings": [{"syntax": "POPFD", "opcode": "9D（32bit モード既定）", "bytes": 1}],
      "notes": "IF/IOPL の変更には CPL≤IOPL が必要。VM/RF ビットは書き換えられない。\\n",
