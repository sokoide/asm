      "notes": "C=1 が「dst < src」（符号なし）。分岐・setcc と組み合わせる。",
      "src": "book"
    },
    {
      "mnemonic": "SBB",
      "operands": "dst, src",
      "category": "算術",
      "summary": "キャリー込み減算。dst = dst - src - C。多倍長減算の上位ワード処理に使う。",
      "addressing": ["レジスタ", "即値", "間接(base+index×scale+disp)"],
      "flags": ["‡", "-", "-", "‡", "‡", "‡", "‡", "‡"],
      "cycles": [{"cond": "reg-reg / 即値→reg", "cycles": 2}, {"cond": "mem を含む", "cycles": "6〜7"}],
