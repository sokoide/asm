      "flags": ["‡", "-", "-", "‡", "‡", "‡", "‡", "‡"],
      "cycles": [{"cond": "reg", "cycles": 2}, {"cond": "mem", "cycles": 6}],
      "encodings": [{"syntax": "NEG r/m8", "opcode": "F6 /3", "bytes": 2}, {"syntax": "NEG r/m16/32", "opcode": "F7 /3", "bytes": 2}],
      "notes": "dst=0 のとき C=0・ZF=1、それ以外は C=1。",
      "src": "book"
    },
    {
      "mnemonic": "MUL",
      "operands": "src",
      "category": "算術",
      "summary": "符号なし乗算。EDX:EAX = EAX × src（32bit）。結果の上位半分が EDX に入る。",
      "addressing": ["レジスタ", "間接(base+index×scale+disp)"],
      "flags": ["‡", "-", "-", "U", "U", "U", "U", "‡"],
