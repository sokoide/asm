      "cycles": [{"cond": "reg", "cycles": 2}, {"cond": "mem", "cycles": 6}],
      "encodings": [{"syntax": "INC r16/32", "opcode": "40+r", "bytes": 1}, {"syntax": "INC r/m8", "opcode": "FE /0", "bytes": 2}, {"syntax": "INC r/m16/32", "opcode": "FF /0", "bytes": 2}],
      "notes": "C を保存するためキャリーを利用するループ内カウンタに安全。",
      "src": "book"
    },
    {
      "mnemonic": "DEC",
      "operands": "dst",
      "category": "算術",
      "summary": "dst を 1 減算する。C フラグは変化しない。",
      "addressing": ["レジスタ", "間接(base+index×scale+disp)"],
      "flags": ["‡", "-", "-", "‡", "‡", "‡", "‡", "-"],
      "cycles": [{"cond": "reg", "cycles": 2}, {"cond": "mem", "cycles": 6}],
      "encodings": [{"syntax": "DEC r16/32", "opcode": "48+r", "bytes": 1}, {"syntax": "DEC r/m8", "opcode": "FE /1", "bytes": 2}, {"syntax": "DEC r/m16/32", "opcode": "FF /1", "bytes": 2}],
      "notes": "8086 と異なり 32bit レジスタを 1 命令で減算できる。",
      "src": "book"
    },
    {
      "mnemonic": "NEG",
      "operands": "dst",
      "category": "算術",
      "summary": "dst を符号反転する（dst = 0 - dst、2 の補数）。",
