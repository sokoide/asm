      "src": "book"
    },
    {
      "mnemonic": "IDIV",
      "operands": "src",
      "category": "算術",
      "summary": "符号付き除算。EDX:EAX ÷ src で EAX=商、EDX=剰余（32bit）。商は 0 方向へ丸め、剰余は被除数と同符号。",
      "addressing": ["レジスタ", "間接(base+index×scale+disp)"],
      "flags": ["U", "-", "-", "U", "U", "U", "U", "U"],
      "cycles": [{"cond": "8bit", "cycles": "16〜24"}, {"cond": "16bit", "cycles": "22〜30"}, {"cond": "32bit", "cycles": "38〜46"}],
      "encodings": [{"syntax": "IDIV r/m8", "opcode": "F6 /7", "bytes": 2}, {"syntax": "IDIV r/m16/32", "opcode": "F7 /7", "bytes": 2}],
      "notes": "符号拡張準備: 32bit は CDQ（99）、16bit は CWD（66 99）。",
      "src": "book"
    },
